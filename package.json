{
  "name": "@billkit-eu/react",
  "version": "1.0.0",
  "description": "React bindings for BillKit's embedded checkout: <BillKitProvider> + <CheckoutElement/>, @stripe/react-stripe-js-shaped and SSR-safe.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "check:package": "npm run build && publint --strict && attw --pack . && node scripts/check-exports.mjs",
    "prepublishOnly": "npm run build && npm run test && npm run typecheck && publint --strict && npm_config_dry_run=false attw --pack . && node scripts/check-exports.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "billkit",
    "react",
    "checkout",
    "payment-element",
    "embedded",
    "mollie",
    "stripe"
  ],
  "author": "BillKit",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/billkit-eu/billkit-react.git"
  },
  "homepage": "https://github.com/billkit-eu/billkit-react#readme",
  "bugs": {
    "url": "https://github.com/billkit-eu/billkit-react/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@billkit-eu/js": "^1.0.0",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@billkit-eu/js": "^1.0.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^10.7.0",
    "jsdom": "^25.0.1",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "sideEffects": false
}
